{
  "name": "green-patrol",
  "version": "1.0.0",
  "type": "module",
  "description": "Green Patrol (Зелений патруль) - Educational wildfire prevention simulator for GENIUS Olympiad",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "format": "prettier --write \"src/**/*.{ts,html,css}\" \"tests/**/*.ts\""
  },
  "keywords": [
    "wildfire",
    "cellular-automata",
    "simulation",
    "education",
    "genius-olympiad"
  ],
  "author": "Green Patrol Team",
  "license": "MIT",
  "devDependencies": {
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^6.4.6",
    "vitest": "^4.1.12"
  }
}
